#!/bin/sh
# Action 1 only. One attempt per boot; no controller reset/reload loop.
umask 077
STATE=/tmp/oa_usbnet.status
MODULES=${OA_USB_MODULES:-/usr/lib/oa-usb}
disabled() {
    [ -f /tmp/SD0/OA_USB_DISABLE ] || [ -f /tmp/user_data/OA_USB_DISABLE ]
}
fail() { echo "error:$1" > "$STATE"; exit 1; }
loaded() { grep -q "^$1 " /proc/modules; }
stock() { loaded "$1" || modprobe "${2:-$1}"; loaded "$1" || fail "$1"; }
patched() { loaded "$1" || insmod "$MODULES/$2"; loaded "$1" || fail "$1"; }
mkdir /tmp/oa_usbnet.lock 2>/dev/null || exit 0
trap 'rmdir /tmp/oa_usbnet.lock' EXIT
disabled && { echo disabled > "$STATE"; exit 0; }
if [ "$1" = boot ]; then
    echo waiting_for_camera > "$STATE"
    # RTOS initialization and the S99 notification must finish first.
    n=0
    while [ "$n" -lt 90 ]; do
        read seconds rest < /proc/uptime
        seconds=${seconds%%.*}
        if [ "$seconds" -ge 60 ] && [ "$(cat /tmp/oa_rtmp_web/bridge.status 2>/dev/null)" = ready ]; then
            break
        fi
        sleep 2
        n=$((n + 1))
    done
    [ "$n" -lt 90 ] || fail camera_not_ready
fi
disabled && { echo disabled > "$STATE"; exit 0; }
loaded ambarella_udc && fail legacy_controller_loaded
echo loading > "$STATE"
stock udc_core udc-core
patched dwc3_ambarella dwc3-ambarella-internal48.ko
stock dwc3
stock libcomposite
stock u_ether
stock usb_f_ecm
patched usb_f_rndis usb_f_rndis-win.ko
if ! loaded g_ether; then
    insmod "$MODULES/g_ether-rndis-win.ko" dev_addr=02:44:4a:49:00:02 host_addr=02:44:4a:49:00:01 iSerialNumber=OA1USBNET2 iProduct=Action1_USB_Network
fi
loaded g_ether || fail g_ether
[ -d /sys/class/net/usb0 ] || fail usb0_missing
ifconfig usb0 192.168.77.2 netmask 255.255.255.0 up || fail address
cat > /tmp/oa_usb_dhcp.conf <<'EOF'
start 192.168.77.1
end 192.168.77.1
interface usb0
max_leases 1
lease_file /tmp/oa_usb.leases
pidfile /tmp/oa_usb_dhcp.pid
option subnet 255.255.255.0
option lease 3600
EOF
dhcp_running=false
if [ -r /tmp/oa_usb_dhcp.pid ]; then
    p=$(cat /tmp/oa_usb_dhcp.pid)
    case "$p" in ''|*[!0-9]*) ;; *)
        if [ -r "/proc/$p/cmdline" ] && tr '\000' ' ' < "/proc/$p/cmdline" | grep -q 'udhcpd /tmp/oa_usb_dhcp.conf'; then
            dhcp_running=true
        fi ;;
    esac
fi
if [ "$dhcp_running" = false ]; then
    udhcpd /tmp/oa_usb_dhcp.conf || fail dhcp
fi
echo ready > "$STATE"
exit 0
